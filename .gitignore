# Ignore everything
*

# Root-level files
!.gitignore
!.gitattributes
!.dockerignore
!docker-compose.yml
!deploy.sh
!LICENSE
!README.md

# Root-level folders
!guides/
!guides/**/*

!platform/
!platform/**/*

# Human guide translations (see docs/TRANSLATING.md)
!translations/
!translations/**/*

# Only the translation contributor guide from docs/ is public
!docs/
!docs/TRANSLATING.md

# --- Re-ignore generated/dependency/secret content living inside the folders
# above (the recursive un-ignores otherwise expose all of it) ---

# Rust build output
platform/target/

# Web (SvelteKit) build output + deps
platform/web/node_modules/
platform/web/.svelte-kit/
platform/web/build/
.data/
platform/.data/
platform/web/.data/
platform/web/data/
*.db
*.sqlite
*.sqlite3
.claude/
.gstack/
.cursor/
.windsurf/
.continue/
.aider*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.env
/dist/
/.cache/

# Maintainer-only notes, not needed in the public repo
platform/web/AGENT-DISCOVERY.md
platform/web/static/audio/README.md
!data/
data/*
!data/aisearch/
data/aisearch/*
!data/aisearch/.gitkeep
!.gitkeep

# voli project memory (local knowledge, not for the repo)
.voli/

# generated by `voli memory prompt`; regenerate rather than commit it
voli-memory-prompt*.md
